# Copy to .env and fill in. Every value is optional; defaults are shown.

# ── Core ─────────────────────────────────────────────────────────────────────
# Signs session cookies. If unset, a random key is generated once and kept in
# instance/.secret_key. Set it explicitly when running more than one server.
SECRET_KEY=
# SQLite file in instance/ by default. Use PostgreSQL for large cohorts, e.g.
# postgresql://netra:password@localhost/netra
DATABASE_URL=sqlite:///exam_platform.db
PORT=8800
HOST=0.0.0.0
# Local development only: enables the Werkzeug debugger and then listens on
# 127.0.0.1 only. Never set this for an exam.
FLASK_DEBUG=false
# Sign out a session that has been idle this many minutes (shared lab PCs)
SESSION_IDLE_MINUTES=60
# Mark session cookies HTTPS-only. Set true behind an HTTPS proxy such as
# nginx. (To make app.py itself serve HTTPS, start it with --ssl.)
USE_SSL=false
# Maximum upload size in bytes (question and student files)
MAX_CONTENT_LENGTH=16777216

# ── Real-time / proctoring ───────────────────────────────────────────────────
# Extra origins allowed to open a Socket.IO connection, comma-separated.
# Leave empty for same-origin only (the safe default).
SOCKETIO_CORS_ORIGINS=
# Seconds between webcam frames inspected per student (client follows this)
NETRA_FRAME_INTERVAL_SEC=4.0
# Where the OpenVINO / anti-spoof model files live (default: ai_models/)
NETRA_MODEL_DIR=

# ── Email (OTP for self-registration) ────────────────────────────────────────
# Without SMTP credentials the OTP is printed to the server console instead.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
